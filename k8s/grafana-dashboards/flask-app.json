{
  "title": "Flask App — Request Metrics",
  "uid": "flask-app-dashboard",
  "schemaVersion": 38,
  "tags": ["flask", "platform-lab"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(flask_request_count_total[1m])) by (endpoint)",
          "legendFormat": "{{ endpoint }}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 2,
      "title": "Request Latency — p50 / p95 / p99",
      "type": "timeseries",
      "description": "面試重點：Histogram 類型的 metric 讓你用 histogram_quantile() 算出精確百分位數。Counter 或 Gauge 做不到這件事。",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(flask_request_latency_seconds_bucket[1m])) by (le, endpoint))",
          "legendFormat": "p50 {{ endpoint }}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(flask_request_latency_seconds_bucket[1m])) by (le, endpoint))",
          "legendFormat": "p95 {{ endpoint }}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(flask_request_latency_seconds_bucket[1m])) by (le, endpoint))",
          "legendFormat": "p99 {{ endpoint }}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 3,
      "title": "Error Rate (5xx)",
      "type": "gauge",
      "description": "5xx 錯誤率超過 5% 觸發 PrometheusRule 告警",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(flask_request_count_total{status_code=~\"5..\"}[5m])) / sum(rate(flask_request_count_total[5m]))",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "max": 1, "min": 0
        }
      }
    },
    {
      "id": 4,
      "title": "Active In-flight Requests",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "flask_active_requests",
          "legendFormat": "Active Requests",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 5,
      "title": "HPA Current vs Max Replicas",
      "type": "timeseries",
      "description": "當 current 觸碰到 max 時，PrometheusRule HPAMaxReplicasReached 告警會觸發",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{horizontalpodautoscaler=\"flask-app-hpa\"}",
          "legendFormat": "Current Replicas",
          "refId": "A"
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{horizontalpodautoscaler=\"flask-app-hpa\"}",
          "legendFormat": "Max Replicas (limit)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    }
  ]
}
